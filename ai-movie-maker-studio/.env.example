# ---- Backend (server/) settings. Copy to .env and fill in. NEVER put these in frontend code. ----

# Google Gemini API key (paid Google service). Leave empty to keep ALL AI generation disabled.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Optional model overrides (defaults shown)
# GEMINI_TEXT_MODEL="gemini-2.5-flash"
# GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
# GEMINI_VIDEO_MODEL="veo-3.0-generate-001"

# Optional password for your server. If set, enter the same value in the app:
# Cloud Settings -> Studio Access Token. Strongly recommended when the server is public.
# STUDIO_ACCESS_TOKEN=""

# Port of the backend (default 8787). In dev, Vite (port 3000) proxies /api, /health, /media to it.
# PORT=8787

# Where generated videos / assembled movies are stored on the server (default ./server-data/media)
# MEDIA_DIR="server-data/media"

# Path to ffmpeg if it is not on PATH
# FFMPEG_PATH="ffmpeg"

# Only needed if the frontend is hosted on a different origin than the backend
# CORS_ORIGIN="https://your-frontend.example.com"

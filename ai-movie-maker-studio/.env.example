# ---- Backend (server/) settings. Copy to .env for local use. On Cloud Run they are set by
# ---- deploy/deploy-cloudrun.sh (secrets come from Secret Manager). Never put these in frontend code.

# Gemini API key (PAID Google service). Empty = all AI generation disabled.
# Without sign-in (local development) a real key also needs STUDIO_ACCESS_TOKEN below.
GEMINI_API_KEY=""
# GEMINI_TEXT_MODEL="gemini-2.5-flash"
# GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
# GEMINI_VIDEO_MODEL="veo-3.0-generate-001"

# --- Sign-in (required for Cloud Sync, required on Cloud Run) ---
# OAuth "Web application" client ID from Google Cloud Console -> APIs & Services -> Credentials
# GOOGLE_OAUTH_CLIENT_ID="1234-abc.apps.googleusercontent.com"
# Random string, at least 32 characters (signs the login cookie)
# SESSION_SECRET=""
# REQUIRED when sign-in is on: comma-separated Google accounts (empty / only commas / invalid => server refuses to start)
# ALLOWED_EMAILS="me@gmail.com,friend@gmail.com"

# --- Google Cloud ---
# GOOGLE_CLOUD_PROJECT="my-project"
# FIRESTORE_ENABLED="true"            # required on Cloud Run (projects, video jobs, quotas)
# FIRESTORE_DATABASE_ID="(default)"
# GCS_BUCKET="my-project-movie-studio-media"
# GCS_SIGNED_URLS="true"              # big uploads/downloads go straight to GCS (needs roles/iam.serviceAccountTokenCreator)
# JOB_QUEUE="inline"                  # only "inline" is implemented

# --- Limits (defaults shown; per user unless noted) ---
# QUOTA_CHAT_PER_MIN=20     QUOTA_CHAT_PER_DAY=300
# QUOTA_IMAGE_PER_MIN=30    QUOTA_IMAGE_PER_DAY=400
# QUOTA_VIDEO_PER_MIN=4     QUOTA_VIDEO_PER_DAY=40
# QUOTA_STORY_PER_MIN=3     QUOTA_STORY_PER_DAY=30
# QUOTA_PROJECT_IMAGE_PER_DAY=200   QUOTA_PROJECT_VIDEO_PER_DAY=20     # per project

# --- Cross-site use (only if the frontend is on another domain than the backend) ---
# Exact origins, comma-separated. No wildcards.
# CORS_ORIGINS="https://app.example.com"

# --- Local development only ---
# PORT=8787
# HOST=127.0.0.1                      # local dev server listens on this computer only
# MEDIA_DIR="server-data/media"      # used only when GCS_BUCKET is empty (refused on Cloud Run)
# STUDIO_ACCESS_TOKEN=""              # password for the API when sign-in is off (required with a real GEMINI_API_KEY)
# FFMPEG_PATH="ffmpeg"

# কপি করে .env নামে সেভ করো। .env কখনো GitHub-এ তুলবে না।

# ---- ১. Gemini API (Google AI Studio থেকে key) ----
GEMINI_API_KEY=

# মডেল (বদলানোর দরকার নেই, Google নতুন মডেল দিলে এখানে নাম বদলালেই হবে)
VIDEO_MODEL=gemini-omni-1.2-flash
IMAGE_MODEL=gemini-nano-banana-2.1
TEXT_MODEL=gemini-3.8-flash
# প্রধান লেখার মডেল ব্যস্ত বা বন্ধ থাকলে এগুলো পরপর চেষ্টা হয়
TEXT_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash-lite
# চরিত্রের কণ্ঠ শোনার জন্য (প্রতিটি কণ্ঠ একবার বানিয়ে জমা রাখে)
TTS_MODEL=gemini-3.8-flash-tts
# ছবির ঘরে যে মডেলগুলো বাছাই করা যাবে
IMAGE_MODELS=gemini-nano-banana-2.1,gemini-3.1-flash-lite-image,gemini-3-pro-image
# প্রতিটি ছবি/ভিডিওর AI দিয়ে বাংলা শিরোনাম (0 দিলে বন্ধ, তখন প্রম্পটের প্রথম শব্দগুলো)
AUTO_TITLES=1

# ---- ২. Gmail লগইন ----
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
# তোমার Gmail। এই ইমেইল মালিক, সব সীমার বাইরে, আর অন্যদের অনুমতি দিতে পারে।
OWNER_EMAIL=
# 1 দিলে যে কেউ Gmail দিয়ে ঢুকতে পারবে (তোমার API খরচ হবে!)। সাধারণত 0 রাখো।
OPEN_SIGNUP=0

# ---- ৩. সার্ভার ----
PORT=3200
# অ্যাপের আসল ঠিকানা, যেমন https://ruvo.up.railway.app (https হলে কুকি নিরাপদ হয়)
PUBLIC_URL=
DATA_DIR=./data

# ---- ৪. খরচ নিয়ন্ত্রণ (মালিকের জন্য প্রযোজ্য নয়) ----
DAILY_VIDEO_LIMIT=10
DAILY_IMAGE_LIMIT=40
# একজন একসাথে কয়টা জিনিস বানাতে পারবে
MAX_RUNNING_JOBS=2
# ট্র্যাশের ফাইল কত দিন পর স্থায়ীভাবে মুছবে
TRASH_DAYS=30

# ---- ৫. আনুমানিক খরচ দেখানো (০ দিলে দেখাবে না; আসল দাম Google-এর pricing পেজে দেখে বসাও) ----
VIDEO_USD_PER_SEC=0.07
IMAGE_USD=0
USD_TO_BDT=124

# প্রতিজনের মোট জায়গার সীমা (MB)। মালিকের সীমা নেই।
STORAGE_LIMIT_MB=2048
# প্রতি মিনিটে কয়টা তৈরির অনুরোধ (প্রতিজন), আর কয়টা লেখার অনুরোধ (প্রম্পট উন্নত, গল্প, সহকারী)
GEN_RATE_PER_MIN=20
TEXT_RATE_PER_MIN=20
# দৈনিক সীমা কোন সময়-অঞ্চলের মাঝরাতে নতুন হয়
DAY_RESET_TZ=Asia/Dhaka
# শেষ/ব্যর্থ কাজের ইতিহাস কত দিন রাখা হবে
HISTORY_DAYS=90

# ---- ৬. ডেটাবেস ও ফাইল (অনেক ব্যবহারকারী/একাধিক সার্ভারের জন্য) ----
# খালি রাখলে DATA_DIR-এ SQLite (একটা সার্ভারের জন্য যথেষ্ট)।
# PostgreSQL দিলে একাধিক সার্ভার একসাথে চালানো যায়: postgres://user:pass@host:5432/db?sslmode=require
DATABASE_URL=
DB_POOL_SIZE=10
# local = DATA_DIR/media-তে; s3 = S3-সামঞ্জস্যপূর্ণ স্টোরেজ (AWS S3, Cloudflare R2, Backblaze B2, MinIO)
STORAGE=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# 1 = https://endpoint/bucket/key (R2, MinIO), 0 = https://bucket.endpoint/key
S3_PATH_STYLE=1
# ব্রাউজারকে দেওয়া সই করা লিংক কত সেকেন্ড চলবে
S3_LINK_SECONDS=300
# গ্যালারির এক পাতায় কয়টা ফাইল ("আরও দেখাও")
ASSET_PAGE_SIZE=200

# ---- ৭. একাধিক সার্ভার ----
# সব সার্ভারে একই রাখো (না দিলে ডেটাবেসে একটা বানিয়ে জমা রাখে)। কমপক্ষে ৩২ অক্ষর, গোপন।
SESSION_SECRET=
# লোড ব্যালান্সার/প্রক্সির পেছনে থাকলে 1 (তখন X-Forwarded-For থেকে আসল IP নেয়)। সরাসরি ইন্টারনেটে থাকলে 0।
TRUST_PROXY=0
# 0 দিলে এই সার্ভার শুধু ওয়েব/API চালায়, ছবি/ভিডিও তৈরির কাজ ধরে না (আলাদা worker সার্ভার রাখলে)
RUN_WORKER=1
# একটা সার্ভার একসাথে কয়টা তৈরির কাজ চালাবে
WORKER_CONCURRENCY=4
WORKER_POLL_MS=2000
# Google-এ কাজ চলার সময় সার্ভার বন্ধ হলে কত তাড়াতাড়ি অন্য সার্ভার তুলে নেবে (মিলিসেকেন্ড)
JOB_LEASE_EXTRA_MS=60000
SWEEP_MS=30000

# ---- ৭ক. মালিকের কন্ট্রোল প্যানেল (শুধু মালিক; ঢুকতে মালিকের Gmail + এই পাসওয়ার্ড দুটোই লাগে) ----
# এখানে নয়, সার্ভারের Variables-এ (Railway → Variables) বসাও। কখনো GitHub-এ তুলবে না।
# যেকোনো একটা দাও: সাদা পাসওয়ার্ড, অথবা `npm run panel-hash` দিয়ে বানানো হ্যাশ (বেশি নিরাপদ)।
# অ্যাপের ভেতর থেকে পাসওয়ার্ড বদলানো যায় না; বদলাতে হলে এখানেই বদলাও আর সার্ভার আবার চালু করো।
OWNER_PANEL_PASSWORD=
OWNER_PANEL_PASSWORD_HASH=

# ---- ৭খ. "Ruvo সম্পর্কে" পাতায় নির্মাতার নাম আর পদ ----
CREATOR_NAME=Rk™ Dragon
CREATOR_TITLE=চেয়ারম্যান

# ---- ৮. ডকুমেন্টারি স্টুডিও ----
# মডেল (টুল ডাকতে পারে এমন)। বিলিং চালু থাকলে Pro দিতে পারো, যেমন gemini-3.1-pro-preview
DOC_MODEL=gemini-3.5-flash
DOC_MODEL_FALLBACKS=gemini-3.8-flash,gemini-3.5-flash-lite
# নতুন প্রজেক্টের ডিফল্ট বাজেট (ডলার)
DOC_BUDGET_USD=5
# একটা ফাইল আপলোডের সর্বোচ্চ আকার (MB)
DOC_UPLOAD_MB=300
# কণ্ঠের আনুমানিক খরচ, প্রতি ১০০০ অক্ষর (০ = অজানা, দেখায় না)
TTS_USD_PER_1K_CHARS=0
# YouTube Data API v3 key (console.cloud.google.com → APIs → YouTube Data API v3 → Credentials)। খালি থাকলে YouTube টুল চলে না।
YOUTUBE_API_KEY=

# শুধু নিজের কম্পিউটারে পরীক্ষার জন্য: Gmail ছাড়া যেকোনো নামে ঢোকা যায়। আসল সার্ভারে কখনো 1 রাখবে না।
DEV_LOGIN=0
